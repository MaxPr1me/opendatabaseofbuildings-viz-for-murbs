# ============================================================================
# Canadian MURB Geometry Analysis - .gitignore
# ============================================================================

# --- Raw and large data files ---
# GeoPackage files (national building datasets, typically 100MB-1GB each)
data/**/*.gpkg
data/**/*.gpkg-shm
data/**/*.gpkg-wal

# GeoParquet intermediate/processed files
data/**/*.parquet
data/**/*.geoparquet

# Shapefiles
data/**/*.shp
data/**/*.shx
data/**/*.dbf
data/**/*.prj
data/**/*.cpg
data/**/*.sbn
data/**/*.sbx

# GeoJSON (large)
data/**/*.geojson

# CSV data files in data directory (keep provider CSVs tracked via LFS or explicit include)
# Note: ODB_v3_data_providers.csv files ARE tracked (small metadata files)
data/**/interim/**
data/**/processed/**
data/**/samples/**

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
wheels/

# Virtual environments
.venv/
venv/
ENV/
env/

# --- IDE ---
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Testing ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.pyright/

# --- Outputs (regenerable) ---
outputs/reports/*
outputs/excel/*
outputs/figures/*
outputs/maps/*
outputs/archetypes/*
outputs/gbxml/*
!outputs/README.md
!outputs/reports/.gitkeep
!outputs/excel/.gitkeep
!outputs/figures/.gitkeep
!outputs/maps/.gitkeep
!outputs/archetypes/.gitkeep
!outputs/gbxml/.gitkeep

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Local configuration ---
config/local.yaml
config/local.*.yaml
!config/local.example.yaml

# --- Logs ---
*.log
logs/

# --- Temporary files ---
*.tmp
*.bak
inspect_gpkg.py
